# provider: groq | gemini | fake
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b   # check https://api.groq.com/openai/v1/models; Groq retires models often
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# self-hosted Langfuse (docker compose up). Create org -> project -> Settings -> API Keys.
# Leave both keys empty to run with tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# from the host: http://localhost:3000 ; from inside compose: http://langfuse-web:3000
LANGFUSE_HOST=http://localhost:3000

# usage ledger (SQLite) and the bearer key callers must send once the gateway is exposed
USAGE_DB_PATH=data/usage.sqlite
GATEWAY_API_KEY=
